# ============================================================
# STAI Backend Environment Variables Template
# Copy this file to .env and supply your credentials.
# In production, inject these via your hosting platform's dashboard.
# ============================================================

# Environment & Server
NODE_ENV=development
PORT=5000

# Security (CRITICAL: Use a random 64-character secret in production)
# Generate via: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Database Configuration
# Leave MONGODB_URI blank to use local file storage (./data/*.json)
# For production hosting (Render, Railway, Fly.io, Atlas), set your MongoDB Atlas URI:
MONGODB_URI=
MONGODB_DB_NAME=stai

# Optional: Custom path for local data storage / mounted persistent disk volume
DATA_DIR=

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# Example: https://your-stai-app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Single-Service Hosting (Set to 'true' if serving built frontend from Express)
SERVE_FRONTEND=false

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Ensure your production frontend domain is added to 'Authorized JavaScript Origins'
GOOGLE_CLIENT_ID=

# AI Provider: Google AI Studio (Gemini) — Primary
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Provider: Hugging Face — Fallback
HF_API_KEY=
AI_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Email Service (Gmail SMTP via Google App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_google_app_password_here
MAIL_FROM_NAME=STAI Support

# Python runtime configuration (Optional: backend includes built-in JS engine fallback)
PYTHON_BIN=py
