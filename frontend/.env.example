# ============================================================
# STAI Frontend Environment Variables Template
# ============================================================

# Backend API URL
# For local development: http://localhost:5000/api
# For production hosted backend: https://your-backend-api.onrender.com/api
# (If deploying full-stack on the same domain/service, leave blank or set to /api)
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# Remember to add your frontend domain (e.g. https://your-app.vercel.app)
# to "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
